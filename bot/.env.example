# Chép file này thành `.env` rồi điền. `.env` đã bị .gitignore chặn, không bao giờ lên GitHub.

# ── Cách ghi kết quả — chỉ cần MỘT trong hai ────────────────────────
# Cách 1 (chuẩn): mật khẩu admin của site. Đi qua whitelist trường của /api/val
# nên kể cả bot viết ẩu cũng không chạm được data nhập tay.
ADMIN_PASS=

# Cách 2 (dự phòng): token Cloudflare có quyền KV Edit. Ghi thẳng vào KV,
# KHÔNG đi qua whitelist. Lấy từ C:\Users\MR VAN\.claude\secrets.env
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Tuỳ chọn ────────────────────────────────────────────────────────
SITE_URL=https://0xhieu.xyz
KV_NAMESPACE_ID=b8fab2f8a83f45f0a023d2ba3ce78cde
RUN_AT_HOUR=2
# RUN_ONCE=true   # bật để chạy đúng 1 lượt rồi thoát (dùng lúc test)
